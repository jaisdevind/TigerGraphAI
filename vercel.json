cd C:\Users\devansh\test-app\TigerGraphAI

# Overwrite vercel.json with the corrected content
$fixed = @'
{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "backend/vercel_api.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/vercel_api.py" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
'@

Set-Content -Path "vercel.json" -Value $fixed -Encoding UTF8